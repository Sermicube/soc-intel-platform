# ─────────────────────────────────────────────────────────────
#  SOC Intelligence Platform — Environment Variables Template
#  Copia este archivo como .env y rellena tus API keys reales
# ─────────────────────────────────────────────────────────────

# ─── App Settings ────────────────────────────────────────────
APP_NAME="SOC Intel Platform"
APP_VERSION="1.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/soc_platform.db

# ─── Threat Intelligence API Keys ────────────────────────────
# VirusTotal: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=b687bfce2bcc7758267ea0959e95b28f03926be6b95a425294cffd9882cd5ffe

# AbuseIPDB: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=a30243b90ea3643e757988945b7bf26a4e75e3bafbc81e9391823345e47e750141977cc7c09d7444

# Shodan: https://account.shodan.io/
SHODAN_API_KEY=IvjW8Zh9ieP8k4fTGfp5LjJ4w7irDvIp

# ─── Cache Settings ──────────────────────────────────────────
# Tiempo en segundos que se cachean los resultados (3600 = 1 hora)
CACHE_TTL=3600
CACHE_MAX_SIZE=500

# ─── Report Settings ─────────────────────────────────────────
REPORTS_OUTPUT_DIR=./data/reports
